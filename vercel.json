{
  "version": 2,
  "name": "auditeduca-agentic-lab",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/analyze.js": {
      "runtime": "nodejs20.x",
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": ".env"
    }
  },
  "env": {
    "NODE_ENV": "production",
    "GROQ_API_KEY": "@groq_api_key"
  }
}